{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm --filter @replo/web build",
  "outputDirectory": "apps/web/.next",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.replo.eu/:path*" }
  ]
}
